# --- DJANGO ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=django-insecure-change-this-in-development-only-12345
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=django-insecure-change-this-in-development-only-12345
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost



# --- Oracle Cloud PostgreSQL (development database) ---
# Set OCI_PG_USER and OCI_PG_PASSWORD in backend/.env; do not commit credentials.
OCI_PG_HOST=129.213.102.238
OCI_PG_PORT=5432
OCI_PG_NAME=ricehub
OCI_PG_USER=ricehubuser
OCI_PG_PASSWORD=

OCI_PG_SSLMODE=disable

# --- REDIS ---
REDIS_URL=redis://127.0.0.1:6379/0
SECURITY_EVENT_RETENTION_DAYS=90

# --- FRONTEND ---
FRONTEND_URL=http://localhost:5173

# --- EMAIL ---
# Create a Brevo API key and verify the sender email address in Brevo.
# Keep the API key only in backend/.env or the hosting provider's secret store.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RiceHub
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=
# Locally use the Vite origin. On Render, set this to the exact Vercel origin.
FRONTEND_URL=http://localhost:5173


DJANGO_SECRET_KEY=
DJANGO_DEBUG=False

DJANGO_ALLOWED_HOSTS=
# Comma-separate exact origins when the frontend has more than one deployment.
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

DATABASE_URL=
REDIS_URL=
SECURITY_EVENT_RETENTION_DAYS=90

# Firebase Admin service-account credentials; keep real credentials out of git.
FIREBASE_CREDENTIALS_PATH=
# For hosted workers, use the full service-account JSON as a protected secret instead.
FIREBASE_CREDENTIALS_JSON=

# Production-only S3-compatible media storage (configure these in Render).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=

TIME_ZONE=Asia/Karachi


# --- MANUAL PAYMENTS (automatic billing is disabled) ---
# Supply safe transfer instructions only; never request PINs, passwords, or banking OTPs.
PAYMENT_INSTRUCTIONS=
SADAPAY_ACCOUNT_NAME=
SADAPAY_ACCOUNT_NUMBER=


OCI_OBJECT_STORAGE_NAMESPACE="your_namespace"
OCI_OBJECT_STORAGE_BUCKET="your_bucket"
OCI_OBJECT_STORAGE_REGION="your_region"
OCI_OBJECT_STORAGE_ACCESS_KEY="your_access_key"
OCI_OBJECT_STORAGE_SECRET_KEY="your_secret_key"