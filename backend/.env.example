# --- FRONTEND ---
FRONTEND_URL=http://localhost:5173

# --- EMAIL ---
# Set these to your email provider's SMTP credentials. For Gmail, use an App Password.
# Keep the actual password only in backend/.env; never commit that file.
# In development, leaving SMTP credentials empty prints verification codes in the backend terminal.
# Configure all four settings below to deliver verification and two-step codes to an inbox.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=
# Locally use the Vite origin. On Render, set this to the exact Vercel origin.
FRONTEND_URL=http://localhost:5173


DJANGO_SECRET_KEY=
DJANGO_DEBUG=False

DJANGO_ALLOWED_HOSTS=
# Comma-separate exact origins when the frontend has more than one deployment.
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

DATABASE_URL=
REDIS_URL=
SECURITY_EVENT_RETENTION_DAYS=90

# Firebase Admin service-account credentials; keep real credentials out of git.
FIREBASE_CREDENTIALS_PATH=
# For hosted workers, use the full service-account JSON as a protected secret instead.
FIREBASE_CREDENTIALS_JSON=

# Production-only S3-compatible media storage (configure these in Render).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=

TIME_ZONE=Asia/Karachi

# --- PHONE VERIFICATION SMS ---
# Leave blank until a provider is configured; no OTP is generated or exposed on failure.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- MANUAL PAYMENTS (automatic billing is disabled) ---
# Supply safe transfer instructions only; never request PINs, passwords, or banking OTPs.
PAYMENT_INSTRUCTIONS=